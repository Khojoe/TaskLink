@model TaskLink.Models.ProviderProfile
@{
    ViewData["Title"] = "Edit Profile";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-7 col-lg-6">
            <div class="card border-0 shadow">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-1">Edit Your Profile</h4>
                    <p class="text-muted small mb-4">Update your details below.</p>

                    <form asp-action="Edit" method="post">
                        @if (ViewBag.Errors != null)
                        {
                            <div class="alert alert-danger">
                                <ul>
                                    @foreach (var error in ViewBag.Errors)
                                    {
                                        <li>@error</li>
                                    }
                                </ul>
                            </div>
                        }

                        <div class="mb-3">
                            <label asp-for="Trade" class="form-label fw-semibold"></label>
                            <select asp-for="Trade" class="form-select">
                                <option value="">— Select your trade —</option>
                                @foreach (var t in new[] { "Electrician","Carpenter","Mechanic","Plumber","Phone Repair","Appliance Repair","Mason","Painter","Welder","Other" })
                                {
                                    <option value="@t" selected="@(Model.Trade == t ? "selected" : null)">@t</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Bio" class="form-label fw-semibold"></label>
                            <textarea asp-for="Bio" class="form-control" rows="4"></textarea>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                            <input asp-for="PhoneNumber" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Location" class="form-label fw-semibold"></label>
                            <input asp-for="Location" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="YearsOfExperience" class="form-label fw-semibold"></label>
                            <input asp-for="YearsOfExperience" type="number" class="form-control" min="0" max="60" />
                        </div>

                        <div class="mb-4 form-check">
                            <input asp-for="IsAvailable" class="form-check-input" />
                            <label asp-for="IsAvailable" class="form-check-label">I am currently available for work</label>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 fw-semibold">Update Profile</button>
                        <a asp-action="MyProfile" class="btn btn-outline-secondary w-100 mt-2">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}