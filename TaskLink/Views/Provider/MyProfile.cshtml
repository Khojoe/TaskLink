@model TaskLink.Models.ProviderProfile
@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4">
                    <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card border-0 shadow">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <div class="d-flex align-items-center">
                            <div class="avatar-circle avatar-lg me-3">
                                @(Model.User?.FullName?.Substring(0, 1).ToUpper() ?? "?")
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0">@Model.User?.FullName</h5>
                                <span class="badge bg-primary">@Model.Trade</span>
                            </div>
                        </div>
                        <span class="badge @(Model.IsAvailable ? "bg-success" : "bg-secondary")">
                            @(Model.IsAvailable ? "Available" : "Unavailable")
                        </span>
                    </div>

                    <ul class="list-group list-group-flush mb-4">
                        <li class="list-group-item px-0">
                            <span class="text-muted small">Location</span>
                            <p class="mb-0 fw-semibold">@Model.Location</p>
                        </li>
                        <li class="list-group-item px-0">
                            <span class="text-muted small">Phone</span>
                            <p class="mb-0 fw-semibold">@Model.PhoneNumber</p>
                        </li>
                        <li class="list-group-item px-0">
                            <span class="text-muted small">Experience</span>
                            <p class="mb-0 fw-semibold">@Model.YearsOfExperience years</p>
                        </li>
                        <li class="list-group-item px-0">
                            <span class="text-muted small">Bio</span>
                            <p class="mb-0">@Model.Bio</p>
                        </li>
                    </ul>

                    <a asp-controller="Home" asp-action="ProviderDetail" asp-route-id="@Model.Id"
                       class="btn btn-outline-primary w-100">
                        <i class="bi bi-eye me-1"></i> Preview Public Profile
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
